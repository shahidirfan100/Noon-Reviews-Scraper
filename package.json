{
  "name": "noon-reviews-scraper",
  "version": "1.0.0",
  "type": "module",
  "description": "Scrape reviews from Noon.com using Playwright Firefox",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node check-playwright-version.mjs && node --check src/main.js",
    "postinstall": "npx playwright install firefox"
  },
  "keywords": [
    "apify",
    "scraper",
    "noon"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "apify": "^3.5.2",
    "cheerio": "^1.2.0",
    "crawlee": "^3.15.3",
    "got-scraping": "^4.2.1",
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "@apify/eslint-config": "^2.0.6",
    "@eslint/js": "^9.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.11.0",
    "typescript-eslint": "^8.66.0"
  }
}
